{
    "name": "saveasrouter-extension",
    "version": "1.0.0",
    "description": "SaveAsRouter Chrome Extension with Webpack bundling",
    "scripts": {
        "build": "webpack --mode production",
        "build:dev": "webpack --mode development",
        "build:watch": "webpack --mode development --watch",
        "package": "webpack --mode production && cd dist && zip -r ../saveasrouter.zip . && cd ..",
        "browser:debug": "npm run build:dev && brave-browser --load-extension=$(pwd) --remote-debugging-port=9222"
    },
    "devDependencies": {
        "@babel/core": "^7.23.0",
        "@babel/preset-env": "^7.23.0",
        "babel-loader": "^9.1.3",
        "copy-webpack-plugin": "^14.0.0",
        "webpack": "^5.88.2",
        "webpack-cli": "^5.1.4"
    }
}
