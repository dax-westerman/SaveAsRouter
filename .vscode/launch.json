{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Load Extension",
            "url": "file://${workspaceFolder}/tests/test.html",
            "webRoot": "${workspaceFolder}",
            "runtimeExecutable": "/usr/bin/brave-browser",
            "runtimeArgs": [
                "--load-extension=${workspaceFolder}",
                "--remote-debugging-port=9222",
                "--allow-file-access-from-files"
            ],
            "preLaunchTask": "npm: build:dev",
            "sourceMaps": true,
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Extension",
            "port": 9222,
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "attach",
            "name": "Attach to Service Worker",
            "port": 9222,
            "targetTypes": ["service_worker"],
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true,
            "sourceMapPathOverrides": {
                "webpack://saveasrouter-extension/*": "${workspaceFolder}/*"
            }
        }
    ]
}
